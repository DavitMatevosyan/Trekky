# One origin for the web app, the API and OpenIddict, so the SameSite=Strict session cookie reaches
# /connect/authorize (ADR-0010). TREKKY_SITE_ADDRESS is `:80` behind Tailscale Funnel, which terminates HTTPS
# (ADR-0015), or `localhost` to try the production stack on a laptop with Caddy's own CA.
# TREKKY_API_UPSTREAM is the API's internal address (`api:8080` in Compose, the API app's name on Azure).
{$TREKKY_SITE_ADDRESS::80} {
	# Static files only: compressing an API response makes Caddy change its ETag (a -gzip / -zstd suffix), and the
	# If-Match the app sends back on an edit would then never match (412).
	@compressible not path /api/* /connect/* /.well-known/*
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Tokens live in JavaScript memory (ADR-0010), so only our own scripts may run. The Vite build has no
		# inline scripts; inline styles stay allowed for Radix positioning.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# HSTS for the public name only: on localhost it would force the Vite dev server (http://localhost:5173) to HTTPS.
	@not_localhost not host localhost
	header @not_localhost Strict-Transport-Security "max-age=31536000"

	# API, OAuth endpoints, and OpenID discovery + JWKS. Every request reaching Caddy came in over HTTPS (Funnel, or
	# Caddy's own TLS on localhost), so the API is told so even though the hop from Funnel is plain HTTP.
	@api path /api/* /connect/* /.well-known/openid-configuration /.well-known/jwks
	handle @api {
		reverse_proxy {$TREKKY_API_UPSTREAM:api:8080} {
			header_up X-Forwarded-Proto https
		}
	}

	# Vite fingerprints asset file names, so they can be cached for good. Everything else (index.html) is
	# revalidated, so a deploy never leaves a browser on an old page pointing at deleted assets.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@not_assets not path /assets/* /api/* /connect/* /.well-known/*
	header @not_assets Cache-Control "no-cache"

	# The single-page app: unknown paths serve index.html and the router takes over.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
