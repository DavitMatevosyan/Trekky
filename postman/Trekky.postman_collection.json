{
  "info": {
    "name": "Trekky API",
    "description": "Local API collection, kept in step with the endpoints (ADR-0008). Import postman/Trekky.postman_collection.json in the Postman desktop app.\n\nAuth: run Sign up (or Log in) -> Authorize -> Token once; the session cookie stays in Postman's cookie jar and the tokens are saved as collection variables, which every other request sends as Bearer. When the access token expires (15 min) run Refresh; after logout or a database reset run Log in -> Authorize -> Token again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "redirectUri",
      "value": "http://localhost:5173/auth/callback"
    },
    {
      "key": "email",
      "value": "me@example.com"
    },
    {
      "key": "password",
      "value": "correct horse battery staple"
    },
    {
      "key": "codeVerifier",
      "value": ""
    },
    {
      "key": "codeChallenge",
      "value": ""
    },
    {
      "key": "code",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Auth",
      "description": "TRK-7: sign-up, login, authorization code + PKCE, refresh, logout, current user.",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"organizationName\": \"Acme\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/sign-up"
          }
        },
        {
          "name": "Log in",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Authorize (code + PKCE)",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';",
                  "let verifier = '';",
                  "for (let i = 0; i < 64; i++) verifier += chars[Math.floor(Math.random() * chars.length)];",
                  "const challenge = CryptoJS.SHA256(verifier).toString(CryptoJS.enc.Base64).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.collectionVariables.set('codeVerifier', verifier);",
                  "pm.collectionVariables.set('codeChallenge', challenge);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('redirects to the callback with a code', () => pm.response.to.have.status(302));",
                  "const location = pm.response.headers.get('Location') || '';",
                  "const match = location.match(/[?&]code=([^&]+)/);",
                  "if (match) { pm.collectionVariables.set('code', decodeURIComponent(match[1])); }",
                  "else { console.log('No code in redirect (not logged in? run 1 or 2 first):', location); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/connect/authorize?client_id=trekky-web&response_type=code&redirect_uri={{redirectUri}}&scope=openid email profile offline_access&state=xyz&code_challenge={{codeChallenge}}&code_challenge_method=S256",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "connect",
                "authorize"
              ],
              "query": [
                {
                  "key": "client_id",
                  "value": "trekky-web"
                },
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirectUri}}"
                },
                {
                  "key": "scope",
                  "value": "openid email profile offline_access"
                },
                {
                  "key": "state",
                  "value": "xyz"
                },
                {
                  "key": "code_challenge",
                  "value": "{{codeChallenge}}"
                },
                {
                  "key": "code_challenge_method",
                  "value": "S256"
                }
              ]
            }
          }
        },
        {
          "name": "Token (exchange code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tokens issued', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('access_token', body.access_token);",
                  "if (body.refresh_token) pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "client_id",
                  "value": "trekky-web"
                },
                {
                  "key": "code",
                  "value": "{{code}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirectUri}}"
                },
                {
                  "key": "code_verifier",
                  "value": "{{codeVerifier}}"
                }
              ]
            },
            "url": "{{baseUrl}}/connect/token"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/me"
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('access_token', body.access_token);",
                  "if (body.refresh_token) pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "client_id",
                  "value": "trekky-web"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refresh_token}}"
                }
              ]
            },
            "url": "{{baseUrl}}/connect/token"
          }
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    }
  ]
}
