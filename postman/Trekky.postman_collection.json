{
  "info": {
    "name": "Trekky API",
    "description": "Local API collection, kept in step with the endpoints (ADR-0008). Import postman/Trekky.postman_collection.json in the Postman desktop app.\n\nAuth: run Sign up (or Log in) -> Authorize -> Token once; the session cookie stays in Postman's cookie jar and the tokens are saved as collection variables, which every other request sends as Bearer. When the access token expires (15 min) run Refresh; after logout or a database reset run Log in -> Authorize -> Token again.\n\nRoles (TREK-46, ADR-0026): every request checks the caller's role. Viewer reads; Member also creates and edits work items and comments; Admin and Owner also create projects. A request the role does not allow answers 403.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "redirectUri",
      "value": "http://localhost:5173/auth/callback"
    },
    {
      "key": "email",
      "value": "me@example.com"
    },
    {
      "key": "password",
      "value": "correct horse battery staple"
    },
    {
      "key": "codeVerifier",
      "value": ""
    },
    {
      "key": "codeChallenge",
      "value": ""
    },
    {
      "key": "code",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "workItemId",
      "value": ""
    },
    {
      "key": "workItemEtag",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "commentEtag",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "inviteEmail",
      "value": "invitee@example.com"
    },
    {
      "key": "inviteId",
      "value": ""
    },
    {
      "key": "inviteToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Auth",
      "description": "TRK-7: sign-up, login, authorization code + PKCE, refresh, logout, current user.",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"organizationName\": \"Acme\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/sign-up"
          }
        },
        {
          "name": "Log in",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Authorize (code + PKCE)",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';",
                  "let verifier = '';",
                  "for (let i = 0; i < 64; i++) verifier += chars[Math.floor(Math.random() * chars.length)];",
                  "const challenge = CryptoJS.SHA256(verifier).toString(CryptoJS.enc.Base64).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.collectionVariables.set('codeVerifier', verifier);",
                  "pm.collectionVariables.set('codeChallenge', challenge);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('redirects to the callback with a code', () => pm.response.to.have.status(302));",
                  "const location = pm.response.headers.get('Location') || '';",
                  "const match = location.match(/[?&]code=([^&]+)/);",
                  "if (match) { pm.collectionVariables.set('code', decodeURIComponent(match[1])); }",
                  "else { console.log('No code in redirect: without a session the server sends the browser to /login?returnTo=<this request> (prompt=none gets login_required instead). Run Sign up or Log in first:', location); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/connect/authorize?client_id=trekky-web&response_type=code&redirect_uri={{redirectUri}}&scope=openid email profile offline_access&state=xyz&code_challenge={{codeChallenge}}&code_challenge_method=S256",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "connect",
                "authorize"
              ],
              "query": [
                {
                  "key": "client_id",
                  "value": "trekky-web"
                },
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirectUri}}"
                },
                {
                  "key": "scope",
                  "value": "openid email profile offline_access"
                },
                {
                  "key": "state",
                  "value": "xyz"
                },
                {
                  "key": "code_challenge",
                  "value": "{{codeChallenge}}"
                },
                {
                  "key": "code_challenge_method",
                  "value": "S256"
                }
              ]
            }
          }
        },
        {
          "name": "Token (exchange code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tokens issued', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('access_token', body.access_token);",
                  "if (body.refresh_token) pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "client_id",
                  "value": "trekky-web"
                },
                {
                  "key": "code",
                  "value": "{{code}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirectUri}}"
                },
                {
                  "key": "code_verifier",
                  "value": "{{codeVerifier}}"
                }
              ]
            },
            "url": "{{baseUrl}}/connect/token"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/me"
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('access_token', body.access_token);",
                  "if (body.refresh_token) pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "client_id",
                  "value": "trekky-web"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refresh_token}}"
                }
              ]
            },
            "url": "{{baseUrl}}/connect/token"
          }
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Revokes every token of the user and invalidates their session cookies. Authenticates with the Bearer token or, since TRK-8.1, with the session cookie alone (so logout still works after the tokens have expired)."
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List members",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('members found', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "pm.test('at least the caller', () => pm.expect(items.length).to.be.above(0));",
                  "if (items.length) pm.collectionVariables.set('memberId', items[0].user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/members",
            "description": "The caller's organization's members ({ user: { id, displayName, email }, role }), by display name: who an item can be assigned to (US-13). Saves the first member's id for Assign work item."
          }
        }
      ]
    },
    {
      "name": "Invites",
      "description": "TREK-47 (ADR-0027): Owners and Admins invite people by email. Run Create invite, then Preview invite and Accept invite with no bearer token (they use the token saved from the link). Accept invite signs up a new user, so run it in a fresh cookie jar or after Log out.",
      "item": [
        {
          "name": "Create invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invite sent', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('inviteId', body.invite.id);",
                  "// The token is the link's fragment: {origin}/invite#<token> (ADR-0027).",
                  "pm.collectionVariables.set('inviteToken', body.acceptUrl.split('#')[1]);",
                  "pm.test('link returned', () => pm.expect(body.acceptUrl).to.include('/invite#'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{inviteEmail}}\",\n  \"role\": \"member\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/invites",
            "description": "Owner or Admin. role is admin (Owner only), member or viewer. Answers { invite, acceptUrl, emailSent }; the link is returned only here. 409 when the email is already a member, belongs to another organization, or has an open invite."
          }
        },
        {
          "name": "List invites",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invites listed', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/invites",
            "description": "Open invites (pending or expired), newest first. Owner or Admin."
          }
        },
        {
          "name": "Resend invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invite sent', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('inviteId', body.invite.id);",
                  "// The token is the link's fragment: {origin}/invite#<token> (ADR-0027).",
                  "pm.collectionVariables.set('inviteToken', body.acceptUrl.split('#')[1]);",
                  "pm.test('link returned', () => pm.expect(body.acceptUrl).to.include('/invite#'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/invites/{{inviteId}}/resend",
            "description": "A new link and 7 more days; the previous link stops working. 409 if accepted or withdrawn."
          }
        },
        {
          "name": "Preview invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invite found', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{inviteToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/invites/preview",
            "description": "Anonymous: email, role, organization and inviter for the invite page. 404 unknown token, 410 expired, withdrawn or used."
          }
        },
        {
          "name": "Accept invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('joined', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{inviteToken}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"Invited user\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/invites/accept",
            "description": "Anonymous: creates the account with the invite's email in the inviter's organization and role, and sets the session cookie like Sign up; continue with Authorize to get tokens as the new user."
          }
        },
        {
          "name": "Withdraw invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('withdrawn', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/invites/{{inviteId}}",
            "description": "Withdraw an open invite; its link then answers 410. 409 if already accepted or withdrawn."
          }
        }
      ]
    },
    {
      "name": "Projects",
      "description": "TRK-10: create, list (by name, cursor pagination) and get projects (by id or key; itemCount since TRK-11). Run Auth first; Create project saves projectId.",
      "item": [
        {
          "name": "Create project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('project created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('projectId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Trekky\",\n  \"key\": \"TRK\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/projects",
            "description": "The key must match ^[A-Z][A-Z0-9]{1,9}$ and be unique in the organization (409 otherwise); it never changes. Records a ProjectCreated activity event. Admin or Owner only (403 otherwise)."
          }
        },
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true,
                  "description": "nextCursor from the previous page"
                }
              ]
            }
          }
        },
        {
          "name": "Get project",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
          }
        },
        {
          "name": "Get project by key",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/projects/by-key/TRK",
            "description": "The web app's /TRK URLs use this. 404 when the organization has no project with this key."
          }
        }
      ]
    },
    {
      "name": "Work items",
      "description": "TRK-11: create, list (newest update first, cursor pagination; filter by type and key or title since TRK-11.1), get (by id or key) and edit work items. Run Auth and Create project first; Create work item saves workItemId and its ETag, which Edit sends as If-Match.",
      "item": [
        {
          "name": "Create work item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('work item created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('workItemId', body.id);",
                  "const etag = pm.response.headers.get('ETag');",
                  "if (etag) pm.collectionVariables.set('workItemEtag', etag);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"story\",\n  \"title\": \"Comments on items\",\n  \"descriptionMd\": \"Members can **discuss** an item.\",\n  \"parentId\": null\n}"
            },
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/work-items",
            "description": "type: epic, story, task, subtask, bug or tech_debt. The item starts in To Do with the project's next key (TRK-1, TRK-2, ...). parentId must be an item of the same project whose type the parent rules allow (422 with allowedParentTypes otherwise); a subtask needs one. Records a WorkItemCreated activity event."
          }
        },
        {
          "name": "List work items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/work-items?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                "{{projectId}}",
                "work-items"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true,
                  "description": "nextCursor from the previous page"
                },
                {
