# Production settings for deploy/docker-compose.yml (ADR-0015). Copy to deploy/.env, fill in, keep it private.
# Never commit the filled-in file. Generate passwords with: openssl rand -base64 32 | tr -d '/+='

# The public host name: the Funnel name <TS_HOSTNAME>.<tailnet>.ts.net (no https://).
# To try the stack on a laptop instead: TREKKY_HOST=localhost:8443 and TREKKY_SITE_ADDRESS=localhost.
TREKKY_HOST=trekky.your-tailnet.ts.net
# What Caddy serves: `:80` behind Funnel (Funnel does HTTPS), `localhost` for the laptop trial (Caddy's local CA).
TREKKY_SITE_ADDRESS=:80

# Tailscale Funnel (`docker compose --profile funnel up -d`): an auth key from the Tailscale admin console
# (Settings → Keys). Only needed for the first start; the node then stays logged in (tailscale-state volume).
TS_AUTHKEY=
TS_HOSTNAME=trekky

# Postgres superuser (backups, restores) and database.
POSTGRES_USER=trekky
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trekky

# Application roles (ADR-0002): trekky_owner runs migrations, trekky_app is used by the API under RLS.
TREKKY_OWNER_PASSWORD=change-me
TREKKY_APP_PASSWORD=change-me

# Password of deploy/secrets/{signing,encryption}.pfx (scripts/generate-certificates.sh).
IDENTITY_CERTIFICATE_PASSWORD=change-me

# Nightly backup (time in TZ), local retention in days.
TZ=UTC
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14

# Optional copy off this machine over the S3 API (any S3-compatible bucket). Leave BACKUP_REMOTE empty to keep
# backups only in deploy/backups/ (the backup log then warns every night).
BACKUP_REMOTE=
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
