# Production settings for deploy/docker-compose.yml. Copy to deploy/.env on the VM, fill in, then `chmod 600 .env`.
# Never commit the filled-in file. Generate passwords with: openssl rand -base64 32 | tr -d '/+='

# Public host name (DNS A record → VM public IP). Caddy gets the Let's Encrypt certificate for it.
# Use localhost to try the stack on a laptop (Caddy's local CA, browser warning).
TREKKY_DOMAIN=trekky.example.com

# Postgres superuser (backups, restores) and database.
POSTGRES_USER=trekky
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trekky

# Application roles (ADR-0002): trekky_owner runs migrations, trekky_app is used by the API under RLS.
TREKKY_OWNER_PASSWORD=change-me
TREKKY_APP_PASSWORD=change-me

# Password of deploy/secrets/{signing,encryption}.pfx (scripts/generate-certificates.sh).
IDENTITY_CERTIFICATE_PASSWORD=change-me

# Nightly backup (time in TZ), local retention in days.
TZ=UTC
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14

# Off-VM copy over the S3 API (ADR-0004: Oracle Object Storage, S3 compatibility). Leave BACKUP_REMOTE empty to
# keep backups only on the VM (the backup log then warns every night).
# Oracle: endpoint https://<namespace>.compat.objectstorage.<region>.oraclecloud.com, a "Customer Secret Key" as
# access key / secret, and a private bucket.
BACKUP_REMOTE=offsite:trekky-backups
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
